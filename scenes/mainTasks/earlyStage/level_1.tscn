#new
extends Area2D

@export var lane_id : int = 0

var parent_level : Node2D
var shark_is_here : bool = false

var planted : bool = false
var grown : bool = false
var health : int = 2

@onready var grow_timer : Timer = $GrowTimer
@onready var sprite : Sprite2D = $Sprite2D

func _ready():
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)
	grow_timer.timeout.connect(_on_grow_timer_timeout)
	update_visual()

func _process(_delta):
	if shark_is_here and Input.is_action_just_pressed("interact") and not planted:
		plant_mangrove()

func plant_mangrove():
	planted = true
	grown = false
	health = 2
	grow_timer.start(3.0)
	update_visual()
	
	if parent_level != null:
		parent_level.show_message("Mangrove planted!")

func _on_grow_timer_timeout():
	grown = true
	update_visual()
	
	if parent_level != null:
		parent_level.show_message("Mangrove fully grown!")

func has_mature_mangrove() -> bool:
	return planted and grown and health > 0

func absorb_hit():
	health -= 1
	
	if health <= 0:
		planted = false
		grown = false
	
	update_visual()

func update_visual():
	if sprite == null:
		return
	
	if not planted:
		sprite.scale = Vector2(0.7, 0.7)
		sprite.modulate = Color(0.4, 0.4, 0.4, 1)
	elif planted and not grown:
		sprite.scale = Vector2(0.9, 0.9)
		sprite.modulate = Color(0.5, 1, 0.5, 1)
	else:
		sprite.scale = Vector2(1.2, 1.2)
		sprite.modulate = Color(0.1, 0.8, 0.2, 1)

func _on_body_entered(body):
	if body is Shark:
		shark_is_here = true

func _on_body_exited(body):
	if body is Shark:
		shark_is_here = false
