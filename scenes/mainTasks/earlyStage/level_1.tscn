#new
extends Node2D

var health : int = 5
var score : int = 0
func _ready():
	for spot in mangrove_spots.get_children():
		spot.parent_level = self
	
	update_ui()

func update_ui():
	health_label.text = "Health: " + str(health)
	score_label.text = "Score: " + str(score)

func show_message(new_message : String):
	message_label.text = new_message

func get_random_lane() -> int:
	return randi() % mangrove_spots.get_child_count()

func get_lane_y(lane_id : int) -> float:
	for spot in mangrove_spots.get_children():
		if spot.lane_id == lane_id:
			return spot.global_position.y
	return 0.0

func get_shore_x() -> float:
	return 140.0

func register_pollution(pollution):
	pollution.reached_shore.connect(_on_pollution_reached_shore)
	pollution.cleaned.connect(_on_pollution_cleaned)
	pollution_container.add_child(pollution)

func _on_pollution_cleaned(points : int, pollution):
	score += points
	update_ui()
	show_message("Pollution cleared!")
	if is_instance_valid(pollution):
		pollution.queue_free()

func _on_pollution_reached_shore(lane_id : int, pollution):
	var blocked : bool = false
	
	for spot in mangrove_spots.get_children():
		if spot.lane_id == lane_id and spot.has_mature_mangrove():
			spot.absorb_hit()
			blocked = true
			score += 10
			show_message("Mangrove protected the shore!")
			break
	
	if not blocked:
		health -= 1
		show_message("The shore was damaged!")
	
	update_ui()
	
	if is_instance_valid(pollution):
		pollution.queue_free()
	
	if health <= 0:
		game_over()

func game_over():
	$PollutionSpawner/Timer.stop()
	show_message("Game Over!")


#new
extends Node2D

@export var pollution_scene : PackedScene

var parent_level : Node2D

func _ready():
	parent_level = get_parent()

func _on_timer_timeout():
	if pollution_scene == null:
		return
	
	var pollution = pollution_scene.instantiate()
	var lane_id : int = parent_level.get_random_lane()
	
	pollution.lane_id = lane_id
	pollution.global_position = Vector2(global_position.x, parent_level.get_lane_y(lane_id))
	pollution.target_x = parent_level.get_shore_x()
	
	parent_level.register_pollution(pollution)



#new
extends Area2D

signal reached_shore(lane_id : int, pollution)
signal cleaned(points : int, pollution)

var speed : int = 200
var lane_id : int = 0
var target_x : float = 140.0
var reward_points : int = 5

func _ready():
	body_entered.connect(_on_body_entered)

func _process(delta):
	position.x -= speed * delta
	
	if global_position.x <= target_x:
		reached_shore.emit(lane_id, self)

func _on_body_entered(body):
	if body is Shark:
		cleaned.emit(reward_points, self)


